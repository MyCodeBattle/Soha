[Unit]
Description=Soha multiplayer poker
After=network.target

[Service]
Type=simple
User=soha
Group=soha
WorkingDirectory=/root/Codes/Soha
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
ExecStart=/usr/bin/node packages/server/dist/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/root/Codes/Soha

[Install]
WantedBy=multi-user.target
